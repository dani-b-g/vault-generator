{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["skills/**/*.ts", "tests/**/*.ts", "tools/**/*.ts"],
  "exclude": ["skills/**/vendor/**", "node_modules"]
}
